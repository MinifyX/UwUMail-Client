{
  "name": "uwumail",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @uwumail/desktop dev",
    "tauri": "pnpm --filter @uwumail/desktop tauri",
    "build": "pnpm -r build",
    "build:setup": "node scripts/build-setup.mjs",
    "release": "node scripts/release.mjs",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
