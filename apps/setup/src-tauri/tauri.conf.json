{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UwUMail Setup",
  "version": "0.5.0-beta.3",
  "identifier": "app.uwumail.setup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "publisher": "UwUMail contributors",
    "copyright": "GPL-3.0-only",
    "icon": ["../../desktop/src-tauri/icons/32x32.png", "../../desktop/src-tauri/icons/icon.ico"]
  }
}
