<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the Info.plist that `tauri ios init` generates. -->
<plist version="1.0">
<dict>
	<!-- Shown by iOS when UwUMail asks for Face ID, with the app lock switched on. -->
	<key>NSFaceIDUsageDescription</key>
	<string>UwUMail checks it is you before it shows your mail.</string>

	<!-- "Take photo" for a contact or profile picture: the web view's file picker opens the
	     camera, and iOS asks for this the first time. Without it the app would crash there. -->
	<key>NSCameraUsageDescription</key>
	<string>UwUMail uses the camera only when you take a photo for a contact or your profile picture.</string>

	<!-- Saved attachments land in UwUMail's own folder in the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Lets iOS wake UwUMail up now and then to look for mail. iOS decides when,
	     and never while the phone is busy; there is no service that keeps running. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>

	<!-- Signing in with Microsoft comes back to the app through app.uwumail://oauth
	     (docs/oauth.md); Safari hands the link to UwUMail. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.uwumail.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app.uwumail</string>
			</array>
		</dict>
	</array>

	<!-- UwUMail only uses TLS the way every mail app does. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
